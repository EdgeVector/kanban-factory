<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template only. install-launchd.sh rewrites ProgramArguments, WorkingDirectory,
  HOME/USER/PATH, and log paths for the actual install ROOT before copying to
  ~/Library/LaunchAgents.

  Do not hand-copy this file to LaunchAgents — placeholders would not expand.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edgevector.kanban-factory</string>

  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/scripts/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>USER</key>
    <string>__USER__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>PORT</key>
    <string>4177</string>
    <key>POLL_MS</key>
    <string>60000</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/kanban-factory.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/kanban-factory.err.log</string>
</dict>
</plist>
